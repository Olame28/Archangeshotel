generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id           Int           @id @default(autoincrement())
  name         String
  type         String
  price        Float
  description  String?
  image        String?
  amenities    String?
  order        Int           @default(0)
  reservations Reservation[]
}

model Hall {
  id           Int           @id @default(autoincrement())
  name         String
  capacity     Int
  price        Float         @default(0)
  description  String?
  image        String?
  images       String?
  video        String?
  features     String?
  order        Int           @default(0)
  reservations Reservation[]
}

model Reservation {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  firstName        String
  lastName         String
  email            String
  phone            String
  countryOfOrigin  String?
  nationality      String?
  idDocument       String?
  cityOfProvenance String?
  type             String
  checkin          DateTime
  checkout         DateTime
  guests           Int      @default(1)
  stayPurpose      String?
  room             Room?    @relation(fields: [roomId], references: [id])
  roomId           Int?
  hall             Hall?    @relation(fields: [hallId], references: [id])
  hallId           Int?
  message          String?
  adminNotes       String?
  repliedAt        DateTime?
  paymentMode      String
  companyName      String?
  companyContact   String?
  status           String   @default("PENDING")
  lang             String   @default("fr")
}

model Content {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  category    String
  image       String?
  icon        String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime?
  image       String?
  link        String?
  isVideo     Boolean   @default(false)
  type        String    @default("past")
  photos      String?
  featured    Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Image {
  id        String   @id @default(cuid())
  filename  String
  url       String
  category  String
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Theme {
  id              String   @id @default(cuid())
  name            String   @default("default")
  primaryColor    String   @default("#D4AF37")
  secondaryColor  String   @default("#1a1a2e")
  accentColor     String   @default("#f5f5dc")
  backgroundColor String   @default("#ffffff")
  textColor       String   @default("#1a1a2e")
  layoutVariant   String   @default("classic")
  fontHeading     String   @default("Playfair Display")
  fontBody        String   @default("DM Sans")
  headerStyle     String   @default("transparent")
  heroStyle       String   @default("carousel")
  cardStyle       String   @default("rounded")
  sectionSpacing  String   @default("normal")
  animationStyle  String   @default("smooth")
  borderRadius    String   @default("24px")
  sectionOrder    String?
  effects         String?
  active          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Video {
  id        String   @id @default(cuid())
  title     String
  url       String
  category  String
  thumbnail String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          Int      @id @default(autoincrement())
  icon        String
  title       String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentMethod {
  id          String   @id
  name        String
  provider    String?
  icon        String
  colorFrom   String
  colorTo     String
  available   Boolean  @default(true)
  description String
  order       Int      @default(0)
}
